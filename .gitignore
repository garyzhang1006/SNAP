# Hugging Face read token for the Slurm jobs; never committed
slurm/hf_token

# compute extra: local token file and job outputs
compute extra/hf_token
compute extra/scores/
compute extra/tmp/

# The primary reduction ships its run scripts in the supplement, so the blanket
# runs/ rule above must not swallow them.
!compute extra/primary/runs/
!compute extra/primary/runs/*.py
