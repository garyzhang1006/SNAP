\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Paired prediction differences for the eight contrasts fixed before any of them was computed, in mean squared error of the log aggregate seed standard deviation. Black marks the recipe bootstrap, resampling all 25 recipes over 2,000 refitted draws, with the observed point estimate as the dot. Grey marks 1,000 fold repartitions of the same 25 recipes, with the partition median as the tick, so the two rows separate recipe sampling from fold assignment. The shaded band is the practically meaningful difference of 0.005 that we fixed beforehand, and a negative value favours the first model of the pair. Every interval is a 2.5 to 97.5 percentile range rather than a standard error, and no endpoint here is missing or clipped.\relax }}{28}{figure.caption.26}\protected@file@percent }
\newlabel{fig:prediction}{{3}{28}{Paired prediction differences for the eight contrasts fixed before any of them was computed, in mean squared error of the log aggregate seed standard deviation. Black marks the recipe bootstrap, resampling all 25 recipes over 2,000 refitted draws, with the observed point estimate as the dot. Grey marks 1,000 fold repartitions of the same 25 recipes, with the partition median as the tick, so the two rows separate recipe sampling from fold assignment. The shaded band is the practically meaningful difference of 0.005 that we fixed beforehand, and a negative value favours the first model of the pair. Every interval is a 2.5 to 97.5 percentile range rather than a standard error, and no endpoint here is missing or clipped.\relax }{figure.caption.26}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Trait-removal estimates across all 125 configurations on both score scales, with wild recipe-cluster intervals over 4,999 draws. Each removal row uses the nine remaining traits with equal weights of one ninth, and the final row uses all ten traits. The columns $\sigma _{\rm  agg}$ and $\sigma _{\rm  ind}$ give the aggregate and independence standard deviations in units of $10^{-3}$, so the weighted trace equals $\sigma _{\rm  ind}^2$ and the weighted off-diagonal sum equals $\sigma _{\rm  agg}^2-\sigma _{\rm  ind}^2$.\relax }}{29}{table.caption.28}\protected@file@percent }
\newlabel{tab:original10}{{13}{29}{Trait-removal estimates across all 125 configurations on both score scales, with wild recipe-cluster intervals over 4,999 draws. Each removal row uses the nine remaining traits with equal weights of one ninth, and the final row uses all ten traits. The columns $\sigma _{\rm agg}$ and $\sigma _{\rm ind}$ give the aggregate and independence standard deviations in units of $10^{-3}$, so the weighted trace equals $\sigma _{\rm ind}^2$ and the weighted off-diagonal sum equals $\sigma _{\rm agg}^2-\sigma _{\rm ind}^2$.\relax }{table.caption.28}{}}
